# Copy to .env.local and fill in. Never commit the filled version.
# The nine variables below are the complete set — docs/03-data-model.md §6.

# ── Supabase ────────────────────────────────────────────────────────────────
# Project URL and anon key: Supabase dashboard → Project Settings → API.
# The anon key is safe in the browser; every request it makes is subject to RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses RLS completely. Never prefix with NEXT_PUBLIC_, never
# import into a file carrying 'use client'. Reached only through
# lib/supabase/admin.ts, which is guarded by `import 'server-only'`.
SUPABASE_SERVICE_ROLE_KEY=

# ── Resend (contact form delivery, S8) ─────────────────────────────────────
RESEND_API_KEY=

# Where contact submissions are delivered.
CONTACT_NOTIFY_EMAIL=

# Sender address. Must sit on a domain verified in Resend, or sends fail.
RESEND_FROM_EMAIL=

# ── Cloudflare Turnstile (bot check on the contact form, S8) ───────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Contact rate limiting (S8) ─────────────────────────────────────────────
# Random string. Salts the ip_hash stored on contact_submissions so the raw IP
# is never persisted. Changing it resets every existing rate-limit bucket.
CONTACT_IP_SALT=

# ── Site Production URL ────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://manishkumawat.com

